{
  "name": "plebfm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:security": "node --test tests/host-security.test.cjs",
    "test": "node --test tests/*.test.cjs",
    "prepare": "npx husky install",
    "format": "npx prettier --write .",
    "pretty-quick": "npx pretty-quick --staged",
    "preinstall": "npx only-allow pnpm",
    "storybook": "concurrently \"npm:watch:*\"",
    "build-storybook": "pnpm build:css && pnpm build:storybook",
    "build:css": "tailwindcss -i ./styles/globals.css -o ./public/globals.css",
    "build:storybook": "storybook build",
    "watch:css": "npx tailwindcss -i ./styles/globals.css -o ./public/globals.css --watch",
    "watch:storybook": "storybook dev -p 6007"
  },
  "dependencies": {
