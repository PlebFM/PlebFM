      "path-to-regexp@0.1": "0.1.13",
      "picomatch@2": "2.3.2",
      "picomatch@3": "3.0.2",
      "postcss": "8.5.26",
      "qs@6": "6.16.0",
      "semver@7": "7.7.4",
      "shell-quote": "1.9.0",
      "socks": "2.8.9",
      "store2": "2.14.4",
      "ws@6": "6.2.4",
      "ws@8": "8.21.0",
      "yaml@1": "1.10.3",
      "yaml@2": "2.8.3",
      "sharp": "0.35.4",
      "@orpc/client": "1.13.6",
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "22.x"
  }
}
