    "@storybook/addon-links": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@storybook/react": "10.6.1",
    "@types/cookie": "^0.5.1",
    "@types/node": "18.11.9",
    "@types/react": "18.0.25",
    "@types/react-copy-to-clipboard": "^5.0.4",
    "@types/react-dom": "18.0.9",
    "@types/spotify-web-playback-sdk": "^0.1.15",
    "autoprefixer": "^10.5.4",
    "concurrently": "^7.6.0",
