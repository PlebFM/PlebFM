# MongoDB replica set / Atlas required for atomic payment transactions.
MONGODB_URI=
NEXTAUTH_URL=https://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_BASE_URL=https://localhost:3000

# MDK is the default for all new bids; new subscriptions always use MDK.
PAYMENT_PROVIDER=mdk
MDK_ACCESS_TOKEN=
# This is the wallet. Back it up securely; never commit it or share it in chat.
MDK_MNEMONIC=
# Signing secret for /api/webhooks/mdk, distinct from the SDK /api/mdk callback.
MDK_WEBHOOK_SECRET=
MDK_BASIC_PRODUCT_ID=
MDK_PRO_PRODUCT_ID=
MDK_REQUEST_TIMEOUT_MS=8000
# Enable only after a real withdrawal smoke test and ledger reconciliation.
MDK_PAYOUTS_ENABLED=false
# Bearer secret used by the every-minute /api/jobs/reconcile job.
CRON_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_APP_KEY=
PUSHER_APP_SECRET=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=
NEXT_PUBLIC_PUSHER_CHANNEL=plebfm
NEXT_PUBLIC_MAX_BID=5000

# Custom-domain automation: token scoped to this Vercel project/team.
VERCEL_DOMAIN_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Legacy providers: retain until their outstanding payments/subscriptions clear.
# Only the LNbits read/invoice key is used; never give the app an admin key.
LNBITS_URL=
LNBITS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
