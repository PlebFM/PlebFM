MONGODB_URI=

# Lightning backend: "lnbits" (default) or "mdk"
PAYMENT_PROVIDER=lnbits

# Signs the invoice references the payment flow polls with. Falls back to
# NEXTAUTH_SECRET when unset, but keep it separate so rotating the auth secret
# does not strand in-flight invoices. To rotate: move the old value into
# INVOICE_TOKEN_SECRET_PREVIOUS, set the new one here, drop the old after 1h.
INVOICE_TOKEN_SECRET=
INVOICE_TOKEN_SECRET_PREVIOUS=

# Required when PAYMENT_PROVIDER=lnbits
LNBITS_URL=
LNBITS_API_KEY=
LNBITS_API_KEY_ADMIN=

# Required when PAYMENT_PROVIDER=mdk.
# MDK_MNEMONIC *is* the wallet — back it up, never commit it.
MDK_ACCESS_TOKEN=
MDK_MNEMONIC=
# Optional: sweep destination for manual/automatic payouts
# (Lightning address, LNURL, or BOLT12 offer)
WITHDRAWAL_DESTINATION=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
NODE_TLS_REJECT_UNAUTHORIZED=0

NEXTAUTH_URL=https://localhost:3000
NEXTAUTH_SECRET=

VERCEL_URL=localhost:3000

PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_APP_KEY=
PUSHER_APP_SECRET=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=
NEXT_PUBLIC_PUSHER_CHANNEL=

NEXT_PUBLIC_MAX_BID=5000

NEXT_PUBLIC_BASE_URL=https://localhost:3000

STRIPE_SECRET_KEY=